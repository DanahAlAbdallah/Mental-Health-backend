generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id        String   @id @default(uuid())
  title     String
  content   String
  author    String
  authorId  String
  user      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category  String
  createdAt DateTime @default(now())
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String?   // Made optional to support Google-only OAuth accounts
  role              String
  phone             String?
  avatarUrl         String?
  passwordChangedAt DateTime? // Security tracking: invalidates old JWTs after a password reset
  createdAt         DateTime  @default(now())

  therapistProfile  TherapistProfile?
  articles          Article[]
  resetTokens       PasswordResetToken[] // Relation to manage password reset tokens
  googleId          String?   @unique   // Google OAuth unique identifier
}


// EXTRA INFORMATION THAT ONLY THERAPISTS HAVE (ONE PROFILE PER THERAPIST)
model TherapistProfile {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio               String   @default("")
  specialties       String[]
  languages         String[]
  yearsOfExperience Int?
  sessionPrice      Int?
  sessionType       String   @default("online")
  location          String?
}

model AvailabilitySlot {
  id          String   @id @default(uuid())
  therapistId String
  date        String
  startTime   String
  endTime     String
  isBooked    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Session {
  id          String   @id @default(uuid())
  therapistId String
  patientId   String
  slotId      String
  date        String
  startTime   String
  endTime     String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}